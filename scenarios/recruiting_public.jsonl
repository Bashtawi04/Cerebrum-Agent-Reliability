{"id": "REC-01", "level": 1, "title": "Read-only question: who is still in screening for the HSE Officer job, what they expect, and the above-band flag", "user": "E1052", "script": [{"say": "Which of the HSE Officer applicants are still at the screening stage? I'd like to know what each of them is asking for in salary and whether anything stands out."}], "expect": {"no_effects": ["*"], "pending": {"count": 0}, "audit": {"max_failed_calls": 0}, "reply": {"all_of": ["re:Anand|Krishnamoorthy|CAND-006", "re:Brian|Odhiambo|CAND-008", "re:\\b11[,.\\s]?500\\b|11\\.5\\s?k", "re:\\b9[,.\\s]?200\\b|9\\.2\\s?k"], "any_of": ["re:\\bband\\b", "re:\\b9[,.\\s]?500\\b", "re:\\b(?:above|exceeds?|exceeding|over the)\\b"]}}}
